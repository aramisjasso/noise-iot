# Copia este archivo a .env EN LA RAÍZ DEL REPO (junto a docker-compose.yml) y
# llena los valores. .env está en .gitignore: nunca lo subas.

# Contraseña del usuario de la base (noise_app). La usan tanto el contenedor de
# postgres (POSTGRES_PASSWORD) como subscriber/classifier/monitor (PG_DSN).
POSTGRES_PASSWORD=CHANGE_ME

# Etiqueta de ghcr.io/aramisjasso/noise-iot-server a usar: latest (último de main)
# o sha-<commit> para fijar una versión.
IMAGE_TAG=latest

# Igual que en server/mqtt/.env.example
ESTACION_SITE=tepic
NOISE_THRESHOLD_DBFS=-22
# Carpeta (dentro del contenedor) de un run de analysis/pytorch_audio/train.py.
# Déjalo vacío para usar solo la regla de RMS.
MODEL_RUN_DIR=
CLASSIFIER_POLL_S=15
CLASSIFIER_LOOKBACK_H=24

# Solo si corres el servicio opcional "monitor" (docker compose --profile monitor up):
DISCORD_WEBHOOK_URL=
DISCORD_ROLE_ID=
HEALTHCHECKS_PING_URL=
MONITOR_POLL_S=15
MQTT_DISCONNECT_ALERT_MIN=20
