# Edit this file and rename to .env. Never commit the real .env.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# Optional: mention this role only on new incidents (digits only).
DISCORD_ROLE_ID=
# Optional: external check for the whole server/monitor. Leave blank to disable.
HEALTHCHECKS_PING_URL=
MONITOR_POLL_S=15
MQTT_DISCONNECT_ALERT_MIN=20
# The monitor reads PG_DSN, MQTT_HOST and MQTT_PORT from server/mqtt/.env
