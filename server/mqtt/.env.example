# Copy to server/mqtt/.env and fill in. .env is in .gitignore: never commit it.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=noise-subscriber
PG_DSN=host=localhost port=5432 dbname=noise_iot user=noise_app password=CHANGE_ME
# Where the clips are stored (one folder per node and session).
AUDIO_DIR=C:\noise-data\audio
# Sessions of the estacion/ topics (Jesús's Arduino firmware), stored as files.
ESTACION_DIR=C:\noise-data\estacion
# Site of the nodes that publish on estacion/ (tepic or monterrey).
ESTACION_SITE=tepic
# Optional log file.
LOG_FILE=C:\noise-data\subscriber.log

# classifier.py (analysis/labeling + analysis/pytorch_audio)
# Threshold in dBFS chosen with: python analysis/labeling/label_rms.py --sweep ...
NOISE_THRESHOLD_DBFS=-20
# Run folder printed by analysis/pytorch_audio/train.py; empty = only the RMS rule
MODEL_RUN_DIR=
CLASSIFIER_POLL_S=15
CLASSIFIER_LOOKBACK_H=24
CLASSIFIER_LOG_FILE=C:\noise-data\classifier.log
