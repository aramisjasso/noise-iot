# Copy to server/mqtt/.env and fill in. .env is in .gitignore: never commit it.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=noise-subscriber
PG_DSN=host=localhost port=5432 dbname=noise_iot user=noise_app password=CHANGE_ME
# Where the clips are stored (one folder per node and session).
AUDIO_DIR=C:\noise-data\audio
# Optional log file.
LOG_FILE=C:\noise-data\subscriber.log
