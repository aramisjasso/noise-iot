{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aramisjasso/noise-iot/contracts/message.schema.json",
  "title": "Batch message",
  "description": "One 10-minute measurement window sent by a node to the ingest function.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "seq",
    "window_start",
    "firmware_version",
    "sample_rate_hz",
    "levels_db",
    "climate"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "description": "Unique node identifier, e.g. tepic-01."
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Batch sequence number per node; (node_id, seq) is the idempotency key."
    },
    "window_start": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "Window start in UTC (RFC 3339 with Z suffix), aligned to :00 or :30."
    },
    "firmware_version": {
      "type": "string",
      "description": "Value of FIRMWARE_VERSION flashed on the node."
    },
    "sample_rate_hz": {
      "const": 8000,
      "description": "ADC sample rate in Hz."
    },
    "levels_db": {
      "type": "array",
      "minItems": 600,
      "maxItems": 600,
      "items": {
        "type": [
          "number",
          "null"
        ]
      },
      "description": "One RMS level in dB per 1-second chunk; null if the chunk failed."
    },
    "climate": {
      "type": "array",
      "description": "DHT11 readings taken during the window.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offset_s",
          "temp_c",
          "rh"
        ],
        "properties": {
          "offset_s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 599,
            "description": "Seconds since window_start."
          },
          "temp_c": {
            "type": [
              "number",
              "null"
            ],
            "description": "Temperature in degrees Celsius; null if the read failed."
          },
          "rh": {
            "type": [
              "number",
              "null"
            ],
            "description": "Relative humidity in percent; null if the read failed."
          }
        }
      }
    }
  },
